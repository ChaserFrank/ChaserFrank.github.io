---
import { siteConfig } from "@/data/site";
const currentYear = new Date().getFullYear();
---

<footer class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <p class="text-[var(--white)] font-semibold">{siteConfig.name}</p>
        <p class="text-sm text-[var(--white-icon)]">Backend Developer &amp; Systems Engineer · {siteConfig.location}</p>
      </div>
      <div class="flex items-center gap-5 text-sm">
        <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" class="text-[var(--white-icon)] hover:text-white" aria-label="GitHub">GitHub</a>
        <a href={`mailto:${siteConfig.email}`} class="text-[var(--white-icon)] hover:text-white" aria-label="Email Francis Kimani">Email</a>
      </div>
    </div>
    <div class="mt-10 pt-6 border-t border-[#ffffff10]">
      <p class="text-center text-xs text-[var(--white-icon)]">Copyright © {currentYear} {siteConfig.name}. Template design and code by <a class="hover:text-white" href="https://github.com/Gothsec" target="_blank" rel="noopener noreferrer">Andres Hernandez</a>, distributed by <a class="hover:text-white" href="https://themewagon.com" target="_blank" rel="noopener noreferrer">ThemeWagon</a>.</p>
    </div>
  </div>
</footer>
