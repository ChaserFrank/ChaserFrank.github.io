---
import { siteConfig } from "@/data/site";
const linkedinConfigured = !siteConfig.linkedin.startsWith("LINKEDIN_");
---

<section id="contact" class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Let's talk</h2>
    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">Contact</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <div class="text-[var(--white-icon)] space-y-4">
        <p>Recruiters, engineering teams, and potential collaborators are welcome to get in touch about backend systems, APIs, integrations, or practical software projects.</p>
        <p><span class="text-[var(--white)]">Location:</span> {siteConfig.location}</p>
      </div>
      <div class="space-y-3">
        <a href={`mailto:${siteConfig.email}`} class="flex items-center justify-between rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-4 text-[var(--white)] transition hover:border-[var(--sec)]"><span>Email</span><span class="text-sm text-[var(--white-icon)]">{siteConfig.email} ↗</span></a>
        <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-4 text-[var(--white)] transition hover:border-[var(--sec)]"><span>GitHub</span><span class="text-sm text-[var(--white-icon)]">@ChaserFrank ↗</span></a>
        {linkedinConfigured ? <a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-4 text-[var(--white)] transition hover:border-[var(--sec)]"><span>LinkedIn</span><span class="text-sm text-[var(--white-icon)]">View profile ↗</span></a> : <div class="flex items-center justify-between rounded-xl border border-dashed border-[var(--white-icon-tr)] p-4 text-[var(--white-icon)]"><span>LinkedIn</span><span class="text-sm">URL to be configured</span></div>}
      </div>
    </div>
  </div>
</section>
