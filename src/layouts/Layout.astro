---
interface Props {
  title: string;
}

import { siteConfig } from "@/data/site";

const { title } = Astro.props;
const siteUrl = siteConfig.siteUrl;
const baseUrl = import.meta.env.BASE_URL;
const description = "Francis Kimani is a backend developer in Nairobi building reliable Python systems, APIs, PostgreSQL applications, and AI-powered workflows.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
    <link rel="canonical" href={siteUrl} />
    <link rel="preload" href={`${baseUrl}fonts/montserrat-latin-wght-normal.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta property="og:title" content={`${siteConfig.name} | Backend Developer`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}og.image.png`} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${siteConfig.name} Portfolio`} />
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Francis Kimani",
        "url": "https://chaserfrank.github.io/",
        "sameAs": ["https://github.com/ChaserFrank"],
        "jobTitle": "Backend Developer & Systems Engineer",
        "address": {"addressLocality": "Nairobi", "addressCountry": "KE"},
        "description": "Backend developer focused on Python, APIs, PostgreSQL, systems integration, and AI-powered workflows."
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face { font-family: "Montserrat Variable"; src: url("/fonts/montserrat-latin-wght-normal.woff2") format("woff2-variations"); font-weight: 100 900; font-style: normal; font-display: swap; }
  :root { --background: #101010; --sec: #a476ff; --white: #dfdfdf; --white-icon: #f3f3f398; --white-icon-tr: #f3f3f310; }
  * { font-family: "Montserrat Variable", -apple-system, system-ui, sans-serif; box-sizing: border-box; padding: 0; margin: 0; }
  *::selection { background-color: var(--sec); color: var(--background); }
  html { scroll-behavior: smooth; }
  body { min-width: 320px; }
  :focus-visible { outline: 2px solid var(--sec); outline-offset: 4px; }
  ::-webkit-scrollbar { width: 15px; }
  ::-webkit-scrollbar-track { background: var(--background); }
  ::-webkit-scrollbar-thumb { background: #2c2638; border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--sec); }
  * { scrollbar-width: thin; scrollbar-color: #2c2638 var(--background); }
</style>
